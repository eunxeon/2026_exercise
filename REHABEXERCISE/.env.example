# Set to true to use MSSQL. Leave false to run with mock_data.py fallback.
DB_ENABLED=false

# ODBC driver name installed on the server PC.
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_PORT=
DB_NAME=REHABEXERCISE

# SQL authentication. Leave empty if using Windows authentication.
DB_USERNAME=
DB_PASSWORD=

# Set DB_TRUSTED_CONNECTION=yes for Windows authentication.
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes
DB_CONNECTION_TIMEOUT=3

# Prototype defaults.
DB_MIRROR_ID=mirror-demo-001
PAIRING_CODE_TTL_SECONDS=600
DB_FALLBACK_TO_MOCK=1

# Local-only demo login hash. Empty disables demo login; registration still works.
DEMO_GUARDIAN_PASSWORD_HASH=
